{
  "name": "food-delivery-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test":"jest tests/socket.test.js --testTimeout=15000 --forceExit",
    "test:indexes": "jest tests/indexes.test.js --testTimeout=20000 --forceExit",
    "seed": "node seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.1.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
     "testMatch": [
    "**/tests/socket.test.js",
    "**/tests/indexes.test.js"
  ],
     "forceExit": true,
    "testTimeout": 30000
  }
}
