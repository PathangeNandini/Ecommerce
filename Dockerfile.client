# ─────────────────────────────────────────────
#  Dockerfile.client
#  Multi-stage build: Vite build → nginx serve
# ─────────────────────────────────────────────

# ── Stage 1: build the React app ─────────────
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files and install ALL deps (including devDeps for Vite)
COPY client/package*.json ./
RUN npm ci

# Copy source and build
COPY client/ .
RUN npm run build
# Output is in /app/dist

# ── Stage 2: serve with nginx ─────────────────
FROM nginx:stable-alpine AS runner

# Remove default nginx static content
RUN rm -rf /usr/share/nginx/html/*

# Copy Vite build output into nginx's serve directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config (handles SPA routing + API proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx starts in foreground — required for Docker
CMD ["nginx", "-g", "daemon off;"]
